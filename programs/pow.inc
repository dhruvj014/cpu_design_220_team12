/* pow.inc - SJ16 assembly for 8^2 (result at 0x34), one C string per source line. Owner: Tanisha */
"        .org 0x00\n"
"        LD   R1, [R0+0x30]    ; R1 = base\n"
"        LD   R2, [R0+0x32]    ; R2 = exponent\n"
"        LDI  R3, 1            ; result = 1\n"
"        ST   R3, [R0+0x34]\n"
"loop:   CMP  R2, R0           ; exponent == 0 ?\n"
"        JZ   done\n"
"        MUL  R3, R3, R1       ; result *= base\n"
"        ST   R3, [R0+0x34]\n"
"        ADDI R2, R2, -1       ; exponent -= 1\n"
"        JMP  loop\n"
"done:   HLT\n"
"        .org 0x30\n"
"        .word 8               ; 0x30 base\n"
"        .word 2               ; 0x32 exponent\n"
"        .word 0               ; 0x34 result\n"
"        .word 0               ; 0x36 unused\n"
"        .org 0x38\n"
"        .ascii \"POW 8^2 \"     ; 8-byte tag\n"
